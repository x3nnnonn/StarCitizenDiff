<?xml version="1.0" encoding="utf-16"?>
<ATLConfig atl_name="SC_SSNV_AEGS">
  <AudioTriggers>
    <ATLTrigger atl_name="Play_SSNV_AEGS">
      <WwiseEvent wwise_duration_type="Infinite" wwise_name="Play_SSNV_AEGS" />
      <RTPCDependees>
        <ATLRTPCDependee atl_name="Listener_Volume" />
        <ATLRTPCDependee atl_name="MIX_SFX" />
      </RTPCDependees>
      <ATLPreload atl_name="SC_SSNV_AEGS" />
    </ATLTrigger>
    <ATLTrigger atl_name="Stop_SSNV_AEGS">
      <WwiseEvent wwise_duration_max="1.66766667" wwise_duration_min="1.66766667" wwise_duration_type="OneShot" wwise_name="Stop_SSNV_AEGS" />
      <RTPCDependees>
        <ATLRTPCDependee atl_name="Listener_Volume" />
        <ATLRTPCDependee atl_name="MIX_SFX" />
      </RTPCDependees>
      <ATLPreload atl_name="SC_SSNV_AEGS" />
    </ATLTrigger>
  </AudioTriggers>
  <AudioPreloads>
    <ATLPreloadRequest atl_name="SC_SSNV_AEGS" atl_type="empty" path="Banks/">
      <ATLPlatforms>
        <Platform atl_config_group_name="default" atl_name="pc" />
      </ATLPlatforms>
      <ATLConfigGroup atl_name="default">
        <WwiseFile wwise_name="SSNV_AEGS.bnk" />
      </ATLConfigGroup>
    </ATLPreloadRequest>
  </AudioPreloads>
</ATLConfig>