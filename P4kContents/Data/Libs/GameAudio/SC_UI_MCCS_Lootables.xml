<?xml version="1.0" encoding="utf-16"?>
<ATLConfig xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" atl_name="SC_UI_MCCS_Lootables">
  <AudioTriggers>
    <ATLTrigger atl_name="Play_UI_MCCS_Grenade_Lootable_Loop">
      <WwiseEvent wwise_duration_type="Infinite" wwise_name="Play_UI_MCCS_Grenade_Lootable_Loop" wwise_radius_max="10" />
      <RTPCDependees>
        <ATLRTPCDependee atl_name="MIX_SFX" />
        <ATLRTPCDependee atl_name="Listener_Volume" />
      </RTPCDependees>
      <ATLPreload atl_name="SC_UI_MCCS_Lootables" />
    </ATLTrigger>
    <ATLTrigger atl_name="Play_UI_MCCS_Weapon_Lootable_Loop">
      <WwiseEvent wwise_duration_max="1" wwise_duration_min="1" wwise_duration_type="OneShot" wwise_name="Play_UI_MCCS_Weapon_Lootable_Loop" wwise_radius_max="10" />
      <RTPCDependees>
        <ATLRTPCDependee atl_name="MIX_SFX" />
        <ATLRTPCDependee atl_name="Listener_Volume" />
      </RTPCDependees>
      <ATLPreload atl_name="SC_UI_MCCS_Lootables" />
    </ATLTrigger>
  </AudioTriggers>
  <AudioPreloads>
    <ATLPreloadRequest atl_name="SC_UI_MCCS_Lootables" atl_type="empty" path="Banks/">
      <ATLPlatforms>
        <Platform atl_config_group_name="default" atl_name="pc" />
      </ATLPlatforms>
      <ATLConfigGroup atl_name="default">
        <WwiseFile wwise_name="UI_MCCS_Lootables.bnk" />
      </ATLConfigGroup>
    </ATLPreloadRequest>
  </AudioPreloads>
</ATLConfig>